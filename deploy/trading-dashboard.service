[Unit]
Description=Trading Agent Monitoring Dashboard (Streamlit)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/trading-agent
ExecStart=/home/ubuntu/trading-agent/.venv/bin/streamlit run dashboard/app.py \
    --server.port 8501 \
    --server.address 0.0.0.0 \
    --server.headless true \
    --browser.gatherUsageStats false \
    --server.fileWatcherType none \
    --theme.base dark
Restart=always
RestartSec=15s

# Same env as the agent (Supabase creds + DASHBOARD_PASSWORD)
EnvironmentFile=/home/ubuntu/trading-agent/.env

StandardOutput=journal
StandardError=journal
SyslogIdentifier=trading-dashboard

# Keep the dashboard from starving the trading agent (the priority) on a 1GB VM
MemoryMax=380M
CPUQuota=60%

[Install]
WantedBy=multi-user.target
